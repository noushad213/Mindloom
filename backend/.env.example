# Use the Supabase transaction pooler for normal application traffic.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
# Use the direct/session connection for Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
# Comma-separated exact origins. Add chrome-extension://<extension-id> once known.
CORS_ORIGINS=http://localhost:5173,chrome-extension://REPLACE_WITH_EXTENSION_ID
MAX_TEXT_CHARS=100000
