{
  "manifest_version": 3,
  "name": "Research Tab Manager",
  "version": "1.0",
  "description": "Collects user-approved research tabs.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:5500/*",
      "http://127.0.0.1:5500/*"
    ]
  }
}
